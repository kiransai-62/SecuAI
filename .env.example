GEMINI_MODEL=gemini-2.5-flash

# Strict CORS Policy (Frontend Origin)
# Requests from browser origins other than this exact URL will be blocked.
# Set this to your deployed Vercel frontend URL, e.g., https://secuai.vercel.app
WEB_ORIGIN=https://secuai.vercel.app

# DAST Target Restrictions
# Comma-separated allowlist of hosts permitted for dynamic vulnerability probing (demo target only)
DAST_ALLOWED_HOSTS=demo.secuai.dev

# Optional: Local JWT secret for testing fallback
JWT_SECRET=secuai-production-tenant-secret-2026

# Optional: Scan workspace directory
WORKSPACE_BASE_DIR=/tmp/secuai-workspaces

