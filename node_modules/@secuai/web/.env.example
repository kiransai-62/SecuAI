# ==============================================================================
# SecuAI Frontend Production Environment Variables (Vercel)
# Configure these in the Vercel Dashboard under Settings -> Environment Variables
# ==============================================================================

# Backend API Endpoint (e.g. Render/Railway URL)
VITE_API_URL=https://secuai-api.onrender.com

# Supabase Client Authentication (Public Anon Key ONLY)
# Never expose the service role key to frontend client code
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key
